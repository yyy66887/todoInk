<?xml version="1.0" encoding="utf-8"?>
<!-- 通知原始数据与采集状态属于敏感数据，明确排除自动云备份（方案 2.5）。
     排除目录：Room 数据库 / DataStore / 全部 files 与 cache。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
